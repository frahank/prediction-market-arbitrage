  "cards": [
    {
      "dot": "rose",
      "title": "The finding",
      "items": [
        "No capturable Kalshi/Polymarket arbitrage under the conditions tested",
        "An early run looked profitable until a bid/ask normalization bug was traced",
        "Once fixed, the opportunity disappeared — that correction is the result",
        "23 pairs scannable, 0 counting toward strategy metrics, enforced by the loader"
      ]
    },
    {
      "dot": "cyan",
      "title": "What makes the no trustworthy",
      "items": [
        "Settlement equivalence prescreens can only flag, never clear — default needs_human",
        "Real per-venue fees; an unknown market resolves worst-case, never zero",
        "Books captured further apart than max_skew_ms are discarded, not penalized",
        "Displayed edge is depth-adjusted before any capturable claim is made"
      ]
    },
    {
      "dot": "amber",
      "title": "Safety and omissions",
      "items": [
        "Real orders need three independent gates; missing any one denies",
        "The kill switch has no un-engage method anywhere — clearing is a manual rm",
        "Public research subset: no execution layer, no database tier, no live-order path",
        "The equivalence LLM audit is an operator step; no model client exists in the repo"
      ]
    }
  ]
